{
  "name": "@galaxyproject/orbit",
  "version": "0.8.0",
  "type": "module",
  "description": "AI co-scientist for Galaxy bioinformatics, built on Pi.dev",
  "keywords": [
    "galaxy",
    "bioinformatics",
    "analysis",
    "co-scientist"
  ],
  "author": "Galaxy Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/galaxyproject/orbit"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "bin/",
    "extensions/",
    "lessons/",
    "shared/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "orbit": "./bin/orbit.js"
  },
  "pi": {
    "extensions": [
      "./extensions/orbit"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.81",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@galaxyproject/galaxy-ops": "^0.5.0",
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^6.0.0",
    "marked": "^18.1.2",
    "pi-web-access": "^0.45.0",
    "tus-js-client": "^3.1.0",
    "uuid": "^14.0.3",
    "yaml": "^2.8.2"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "precommit": "lint-staged",
    "prepare": "husky",
    "check:install": "node scripts/install-freshness.mjs",
    "pretest": "npm run check:install",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-version-lockstep.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run smoke:pack",
    "sync:skills": "node scripts/sync-skills.mjs",
    "check:skills": "node scripts/sync-skills.mjs --check",
    "build:lessons": "node lessons/build-snapshot.mjs",
    "check:lessons": "node lessons/build-snapshot.mjs --check",
    "measure:context": "node scripts/measure-context.mjs",
    "sync:foundry-skills": "node scripts/sync-skills.mjs",
    "check:foundry-skills": "node scripts/sync-skills.mjs --check"
  },
  "lint-staged": {
    "*.{json,md,css,html,yml,yaml}": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "dompurify": "^3.4.17",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "protobufjs": true,
    "fsevents": true,
    "@google/genai": true
  }
}
