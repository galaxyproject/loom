{
  "name": "@galaxyproject/orbit-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Orbit's browser shell: the agent in a worker, its providers, the chat and artifact panes, and the Galaxy transport. A flavor mounts it.",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent/index.ts",
    "./artifacts": "./src/artifacts/kinds.ts",
    "./worker": "./src/agent/worker.ts",
    "./node": "./src/node.ts",
    "./testing": "./src/testing.ts",
    "./vite": "./vite.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "orbit-browser-assets": "scripts/install_assets.js"
  },
  "scripts": {
    "build:pyodide": "node scripts/install_pyodide.js",
    "build:skills": "node scripts/install_skills.js",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-durable": "https://github.com/guerler/pi/releases/download/durable-v1.3.0-olit.0/earendil-works-pi-durable-1.3.0-olit.0.tgz",
    "@galaxyproject/galaxy-ops": "https://github.com/guerler/galaxy-mcp/releases/download/ops-v0.4.0-ops.1/galaxyproject-galaxy-ops-0.4.0-ops.1.tgz",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "dompurify": "^3.4.1",
    "marked": "^18.0.0",
    "mermaid": "^11.16.1",
    "pyodide": "^0.29.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "happy-dom": "^20.0.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
