# Vendored skills corpus: a build artifact core/scripts/install_skills.js copies from Orbit's
# extensions/loom/vendor/skills (or fetches from GitHub without it). The exact revision is
# pinned in the committed core/skills.lock.json, so builds stay
# reproducible without carrying 860 KB of third-party content in this repo.
core/src/agent/skills/galaxy-skills/

