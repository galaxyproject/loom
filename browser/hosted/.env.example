# Hosted Orbit's settings. The host checks them all at boot and lists every problem at once; its
# startup summary says which secrets are set without printing them.

# Where browsers reach Orbit. https unless it's localhost.
ORBIT_PUBLIC_URL=http://localhost:7878
# ORBIT_PORT=7878

# Postgres. compose.yaml builds ORBIT_DATABASE_URL from this password, so use URL-safe characters
# only (letters, digits, - _ .): openssl rand -hex 24
POSTGRES_PASSWORD=
# ORBIT_DATABASE_URL=postgres://orbit:password@localhost:5432/orbit

# The Galaxy server conversations run against, and where a user Galaxy doesn't know yet signs in once
# to link their account (defaults to <Galaxy>/login/start).
ORBIT_GALAXY_URL=https://test.galaxyproject.org
# ORBIT_GALAXY_LINK_URL=

# Keycloak: the realm's issuer and Orbit's client. A deployed host uses the confidential orbit
# client with its secret; localhost can use the public orbit-dev client with no secret.
ORBIT_OIDC_ISSUER=https://login.galaxyproject.org/realms/galaxy-test
ORBIT_OIDC_CLIENT_ID=orbit-dev
# ORBIT_OIDC_CLIENT_SECRET=

# Seals refresh tokens at rest: openssl rand -base64 32
ORBIT_TOKEN_KEY=

# The model: any OpenAI-compatible endpoint (TACC's directly, or LiteLLM in front), one service key
# for every user, and the model id. Each request carries the user, for the endpoint's own accounting.
ORBIT_MODEL_URL=
ORBIT_MODEL_KEY=
ORBIT_MODEL=

# Per user message: model steps and tool calls.
# ORBIT_MAX_STEPS=40
# ORBIT_MAX_TOOL_CALLS=60

# The kill switch: set it to a message and every turn is turned away with it.
# ORBIT_TURNS_DISABLED=Orbit is paused for maintenance.

# Leases: how long a worker holds a conversation without renewing, how often it renews, and the
# longest a turn may run (time spent waiting on the user doesn't count).
# ORBIT_LEASE_TTL_SECONDS=60
# ORBIT_LEASE_RENEW_SECONDS=15
# ORBIT_MAX_TURN_SECONDS=1800

# Workers: a conversation with nothing running, nothing asked and no page open gives its worker back
# after this long, and the next message starts a fresh one from the store. A destructive confirm
# nobody answers pauses its conversation after the second setting, freeing the worker; it's asked
# again when the user opens the conversation or sends a message.
# ORBIT_IDLE_RELEASE_SECONDS=600
# ORBIT_ASK_PAUSE_SECONDS=600
