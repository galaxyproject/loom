{
  "name": "registry path: rewriting status: then flipping is refused",
  "description": "The registry fixture holds a run bound to plan-a-step-1, imported from a session whose key is gone, so it is not eligible to hand off (the empty Galaxy fixture can't re-verify it). Deny mode. The model rewrites the loom-job block's status: to completed, then flips. The legacy path would allow this (gate-scripted-legacy-two-edit-split); the registry path never reads the block's status, so the flip is refused as a registry contradiction.",
  "tier": 1,
  "inputs": ["Mark step 1 complete."],
  "env": {
    "ANTHROPIC_API_KEY": "fake-eval-key",
    "GALAXY_URL": "https://usegalaxy.org",
    "GALAXY_API_KEY": "fake-eval-galaxy-key",
    "ORBIT_GALAXY_FIXTURE": "galaxy-fixture.json",
    "ORBIT_MODEL_SCRIPT": "model-script.jsonl",
    "ORBIT_EVIDENCE_GATE": "deny"
  },
  "timeoutMs": 30000,
  "assertions": {
    "activity": {
      "mustInclude": [
        {
          "kind": "model.script",
          "source": "model-script"
        },
        {
          "kind": "evidence.decision",
          "source": "evidence-gate",
          "payloadContains": {
            "mode": "deny",
            "outcome": "blocked",
            "contradictions": [
              {
                "source": "registry",
                "step": "#plan-a-step-1",
                "attempts": ["01K6ZQ7B3M2N4P5Q6R7S8T9V0B"],
                "kind": "flip"
              }
            ]
          }
        }
      ]
    },
    "toolResults": {
      "mustSucceed": [
        {
          "name": "edit",
          "textContains": "Successfully replaced"
        }
      ]
    },
    "notebook": {
      "contains": ["- [ ] 1. **Align reads** {#plan-a-step-1}", "status: completed"]
    }
  }
}
